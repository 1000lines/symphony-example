[Unit]
Description=Symphony host runtime
After=network-online.target symphony-reconcile.service
# Wants, not Requires: if GitHub is unreachable at boot the host should still
# come up on the escript already installed on disk rather than refuse to start
# because a refresh failed.
Wants=network-online.target symphony-reconcile.service

[Service]
Type=simple
User={{SYMPHONY_RUNTIME_USER}}
Group={{SYMPHONY_RUNTIME_GROUP}}
EnvironmentFile={{SYMPHONY_RUNTIME_ENV}}
WorkingDirectory={{SYMPHONY_WORKSPACE_ROOT}}
ExecStart={{SYMPHONY_RUNTIME_BIN}} --i-understand-that-this-will-be-running-without-the-usual-guardrails --logs-root {{SYMPHONY_LOGS_ROOT}} --port {{SYMPHONY_SERVICE_PORT}} {{SYMPHONY_WORKFLOW_PATH}}
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{SYMPHONY_WORKSPACE_ROOT}} {{SYMPHONY_LOGS_ROOT}} {{SYMPHONY_STATE_DIR}}

[Install]
WantedBy=multi-user.target
