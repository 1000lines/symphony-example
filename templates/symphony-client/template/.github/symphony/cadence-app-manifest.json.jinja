{
  "name": [[ cadence_app_slug | to_json ]],
  "url": [[ ("https://github.com/" ~ repo_slug) | to_json ]],
  "description": "Cadence review and feedback for this repository",
  "public": false,
  "default_events": [],
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "actions": "read",
    "pull_requests": "write",
    "issues": "write",
    "checks": "write"
  }
}
